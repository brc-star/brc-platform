# BRC STAR DIGITAL ENTERPRISE PLATFORM - ENVIRONMENT CONFIGURATION

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://brcstar.in
NEXT_PUBLIC_API_URL=https://brcstar.in/api/v1

# Multi-Tenant & Subdomain Configurations
NEXT_PUBLIC_APP_PORTAL_URL=https://app.brcstar.in
NEXT_PUBLIC_INVESTOR_PORTAL_URL=https://investor.brcstar.in
NEXT_PUBLIC_PARTNER_PORTAL_URL=https://partner.brcstar.in
NEXT_PUBLIC_CRM_URL=https://crm.brcstar.in
NEXT_PUBLIC_ERP_URL=https://erp.brcstar.in

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://brc_admin:secure_db_password@localhost:5432/brcstar_enterprise?schema=public&sslmode=prefer"

# Redis Cache & Background Queue
REDIS_URL="redis://localhost:6379"

# Enterprise Security & Encryption Keys
JWT_SECRET="replace_with_32_byte_cryptographically_secure_random_key"
DATA_ROOM_ENCRYPTION_KEY="replace_with_aes_256_gcm_master_key"

# Cloudflare / Storage Provider
OBJECT_STORAGE_ENDPOINT="https://storage.brcstar.in"
OBJECT_STORAGE_BUCKET="brcstar-enterprise-assets"
OBJECT_STORAGE_ACCESS_KEY="your_access_key"
OBJECT_STORAGE_SECRET_KEY="your_secret_key"

# Telemetry & IoT Gateway
TELEMETRY_INGEST_KEY="replace_with_vehicle_telematics_gateway_token"
